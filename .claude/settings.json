{
  "env": {
    "CLAUDE_DELEGATION_CHECK": "1",
    "CLAUDE_DELEGATION_STREAK_N": "8",
    "CLAUDE_SUBAGENT_NOTIFY_SEC": "30",
    "CLAUDE_SUBAGENT_NOTIFY": "native",
    "CLAUDE_SUBAGENT_PROGRESS_SEC": "120",
    "CLAUDE_SUBAGENT_TTL_SEC": "86400",
    "CLAUDE_DELEGATION_FEEDBACK": "next_session"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/block_dangerous_bash.py\" --hook claude || python \"$CLAUDE_PROJECT_DIR/scripts/block_dangerous_bash.py\" --hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_doxygen.py\" --hook claude || python \"$CLAUDE_PROJECT_DIR/scripts/check_doxygen.py\" --hook claude",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/lint_vba.py\" --hook claude || python \"$CLAUDE_PROJECT_DIR/scripts/lint_vba.py\" --hook claude",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/log_bash_output.py\" || python \"$CLAUDE_PROJECT_DIR/scripts/log_bash_output.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/log_bash_output.py\" --failure || python \"$CLAUDE_PROJECT_DIR/scripts/log_bash_output.py\" --failure",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/subagent_track.py\" || python \"$CLAUDE_PROJECT_DIR/scripts/subagent_track.py\"",
            "timeout": 10,
            "statusMessage": "サブエージェント開始を記録中"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/subagent_track.py\" || python \"$CLAUDE_PROJECT_DIR/scripts/subagent_track.py\"",
            "timeout": 10,
            "statusMessage": "サブエージェント完了を記録中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/stop_delegation_check.py\" || python \"$CLAUDE_PROJECT_DIR/scripts/stop_delegation_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/delegation_warn.md 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/logs\" && date +%s > \"$CLAUDE_PROJECT_DIR/.claude/logs/.session-active\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$CLAUDE_PROJECT_DIR/.claude/logs/.session-active\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/notification_toast.py\" permission || python \"$CLAUDE_PROJECT_DIR/scripts/notification_toast.py\" permission",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/notification_toast.py\" idle || python \"$CLAUDE_PROJECT_DIR/scripts/notification_toast.py\" idle",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
